# Apify — used by prospect-posts
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# TheirStack — used by job-search
# Get a key at https://app.theirstack.com/settings/api
THEIRSTACK_API_KEY=

# Unipile — used by linkedin-dm
# Get an API key + your account DSN (e.g. https://api60.unipile.com:19028) at https://dashboard.unipile.com
UNIPILE_API_KEY=
UNIPILE_DSN=
