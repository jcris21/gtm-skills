# Apify — used by prospect-posts
# Get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# TheirStack — used by job-search
# Get a key at https://app.theirstack.com/settings/api
THEIRSTACK_API_KEY=

# Unipile — used by linkedin-dm
# Get an API key + your account DSN (e.g. https://api60.unipile.com:19028) at https://dashboard.unipile.com
UNIPILE_API_KEY=
UNIPILE_DSN=

# Tavily — used by signal-builder for internet discovery scans
# Get an API key at https://tavily.com (free tier: 1,000 searches/month)
TAVILY_API_KEY=

# n8n — used by reply_escalation_webhook.py (Documents/n8n_Reply_Handler_Automation.md Node 6/10)
# The n8n webhook URL that receives escalated (human-needed) replies for Slack HITL approval.
N8N_ESCALATION_WEBHOOK_URL=

# Google Sheets — used by sheet_queue.py (Documents/HITL_Send_Approval_Design.md §3)
# Message-1 send-approval queue. Service account key path + target spreadsheet ID.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Message1Queue
